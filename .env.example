# Phantom — where `.env` lives
# - Copy this file to `.env` at the **repository root** (next to root `package.json`).
# - `DATABASE_URL`, `JWT_SECRET`, and API vars below are loaded by `src/api/src/loadRootEnv.ts`.
# - `npm run db:migrate -w @phantom/api`, `db:seed`, `dev`, and `start` all use that file (cwd-independent).
# - Do not commit real secrets.
#
# --- API (src/api) ---
API_PORT=8787
# Liveness: GET /health/live  ·  Readiness: GET /health (DB + optional Redis)
# Comma-separated CORS origins (credentials enabled). If unset, defaults include
# http://localhost:5173–5174 and http://127.0.0.1:5173–5174.
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT signing — pick ONE approach:
# (A) HS256: single secret (dev / simple deploys)
JWT_SECRET=change_me_to_a_long_random_secret_min_16_chars
# (B) RS256 (recommended prod): PEM keys; newline as \n in .env
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# openssl genrsa -out jwt.pem 2048 && openssl rsa -in jwt.pem -pubout -out jwt.pub.pem

# Stripe (subscription — Checkout, Portal, webhooks)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PAID_MONTHLY=price_...
# Public dashboard origin for Checkout/Portal redirects
# DASHBOARD_PUBLIC_URL=http://localhost:5173

# Broker scan — simulated worker delay per catalog row (ms), `min-max` for /broker-scan/start
# BROKER_SCAN_WORKER_DELAY_MS=5-25

# Phone aliases — adapter (see docs/roadmap/PHONE_INTEGRATION.md)
# PHONE_PROVIDER=mock   (default; +1-555 dev numbers, no Twilio)
# PHONE_PROVIDER=twilio  (requires TWILIO_ACCOUNT_SID; stub SIDs until Number API is wired)
# TWILIO_AUTH_TOKEN=     (future: real Number API / webhooks)
# TWILIO_FROM_NUMBER=    (future: SMS/call origination)

# Inbound alias mail webhook: HMAC-SHA256 over raw JSON body; header X-Phantom-Signature: sha256=<hex>
# Required for POST /api/webhooks/email-inbound (min 16 chars)
# INBOUND_WEBHOOK_SECRET=

# Database (Prisma) — local Postgres: postgresql://USER:PASSWORD@127.0.0.1:5432/phantom
# Docker Compose example below; use your real Windows Postgres user/port if not using Docker.
DATABASE_URL=postgresql://phantom:phantom_dev_password@localhost:5432/phantom

# --- Dashboard (src/dashboard, Vite) ---
# Optional: full origin of the API. If unset, Vite dev server proxies /api to API_PORT.
VITE_API_URL=
# Dev login for SessionBootstrap (seed user — see api prisma seed)
VITE_DEV_EMAIL=dev@phantom.local
VITE_DEV_PASSWORD=devpassword123

# --- Extension (Plasmo) ---
# Public (injected at build time). Must match your local API when testing generation.
PLASMO_PUBLIC_API_URL=http://localhost:8787

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=phantom
POSTGRES_PASSWORD=phantom_dev_password
POSTGRES_DB=phantom
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PORT=6379
# Optional: enables refresh-token sessions (opaque tokens, 7-day TTL). Example:
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# --- Elasticsearch (docker-compose) ---
ELASTICSEARCH_PORT=9200
