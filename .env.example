# --- API (src/api) ---
API_PORT=8787
# Comma-separated origins for CORS (leave empty in dev to allow tooling)
CORS_ORIGIN=http://localhost:5173

# --- Dashboard (src/dashboard, Vite) ---
# Optional: full origin of the API. If unset, Vite dev server proxies /api to API_PORT.
VITE_API_URL=

# --- Extension (Plasmo) ---
# Public (injected at build time). Must match your local API when testing generation.
PLASMO_PUBLIC_API_URL=http://localhost:8787

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=phantom
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=phantom
POSTGRES_PORT=5432
# Future: DATABASE_URL=postgresql://phantom:change_me_in_production@localhost:5432/phantom

# --- Redis (docker-compose) ---
REDIS_PORT=6379
# Future: REDIS_URL=redis://localhost:6379

# --- Elasticsearch (docker-compose) ---
ELASTICSEARCH_PORT=9200
# Future: ELASTICSEARCH_NODE=http://localhost:9200

# --- Future auth / encryption (placeholders) ---
# JWT_ISSUER=https://api.phantom.example
# JWT_AUDIENCE=phantom-clients
