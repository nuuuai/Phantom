# --- API (src/api) ---
API_PORT=8787
# Comma-separated origins for CORS (leave empty in dev to allow tooling)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT signing (min 16 chars; use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret_min_16_chars

# Database (Prisma) — match docker-compose postgres
DATABASE_URL=postgresql://phantom:phantom_dev_password@localhost:5432/phantom

# --- Dashboard (src/dashboard, Vite) ---
# Optional: full origin of the API. If unset, Vite dev server proxies /api to API_PORT.
VITE_API_URL=
# Dev login for SessionBootstrap (seed user — see api prisma seed)
VITE_DEV_EMAIL=dev@phantom.local
VITE_DEV_PASSWORD=devpassword123

# --- Extension (Plasmo) ---
# Public (injected at build time). Must match your local API when testing generation.
PLASMO_PUBLIC_API_URL=http://localhost:8787

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=phantom
POSTGRES_PASSWORD=phantom_dev_password
POSTGRES_DB=phantom
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PORT=6379
# Optional: enables refresh-token sessions (opaque tokens, 7-day TTL). Example:
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# --- Elasticsearch (docker-compose) ---
ELASTICSEARCH_PORT=9200
