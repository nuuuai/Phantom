generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  hashedPassword   String
  tier             UserTier @default(free)
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  /** Mirrors Stripe subscription.status when integrated; `none` when no sub. */
  subscriptionStatus     String?  @default("none")
  vaultSalt        String?
  /** Real inbox address for forward notifications (optional; not verified in Phase 1 stub). */
  forwardToEmail   String?
  /** Opaque E2E-encrypted vault export blob (client holds keys; server is dumb storage). */
  vaultSyncCiphertext String? @db.Text
  vaultSyncVersion    Int     @default(0)
  createdAt        DateTime @default(now())
  aliases          Alias[]
  aliasInboxMessages AliasInboxMessage[]
  brokerScanRuns   BrokerScanRun[]
  brokerScanResults BrokerScanResult[]
  notifications    Notification[]
  notificationPrefs NotificationPref[]
}

model NotificationPref {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  enabled   Boolean              @default(true)

  @@unique([userId, category])
}

enum UserTier {
  free
  paid
  enterprise
}

model Alias {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            AliasType
  value           String
  encryptedValue  String?
  category        AliasCategory
  serviceName     String?
  serviceUrl      String?
  healthStatus    HealthStatus  @default(healthy)
  createdAt       DateTime      @default(now())
  lastActivityAt  DateTime?
  spamCount       Int           @default(0)
  isActive        Boolean       @default(true)
  /** Phone adapter: `mock`, `twilio`, etc. */
  phoneProvider   String?
  phoneProviderSid String?
  /** E.164 real number for forward target (optional). */
  phoneForwardTo  String?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category])
  @@index([userId, healthStatus])
  aliasInboxMessages AliasInboxMessage[]
}

/** Inbound mail captured for an email alias (ingested via signed webhook from MX worker). */
model AliasInboxMessage {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliasId           String
  alias             Alias    @relation(fields: [aliasId], references: [id], onDelete: Cascade)
  subject           String
  fromAddress       String
  snippet           String   @db.Text
  receivedAt        DateTime
  /** Idempotency key from upstream (SES, Mailgun, etc.); null = no dedupe. */
  providerMessageId String?  @unique

  @@index([userId, receivedAt(sort: Desc)])
  @@index([aliasId, receivedAt(sort: Desc)])
}

model DataBroker {
  id              String          @id @default(cuid())
  name            String
  domain          String          @unique
  category        BrokerCategory
  removalMethod   RemovalMethod
  avgRemovalDays  Int
  /** Official opt-out / privacy URL when known; otherwise null (UI falls back to search). */
  removalUrl      String?         @db.Text
  /** Short guidance for manual brokers or when the link may drift. */
  removalNotes    String?         @db.Text
  isActive        Boolean         @default(true)
  scanResults     BrokerScanResult[]
}

model BrokerScanRun {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  totalBrokers   Int
  foundCount     Int                  @default(0)
  results        BrokerScanResult[]

  @@index([userId, startedAt(sort: Desc)])
}

model BrokerScanResult {
  id                   String             @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerScanRunId      String
  brokerScanRun        BrokerScanRun      @relation(fields: [brokerScanRunId], references: [id], onDelete: Cascade)
  brokerId             String
  broker               DataBroker         @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  dataTypesFound       String[]           @default([])
  scanDate             DateTime           @default(now())
  status               BrokerScanStatus
  removalSubmittedAt   DateTime?
  removalConfirmedAt   DateTime?
  relistDetectedAt     DateTime?

  @@index([userId, brokerScanRunId])
  @@index([userId, status])
  @@index([brokerScanRunId, status])
}

enum AliasType {
  email
  phone
  username
  password
}

enum AliasCategory {
  shopping
  social
  finance
  work
  dating
  newsletter
  temp
}

enum HealthStatus {
  healthy
  warning
  compromised
  quarantined
}

enum BrokerCategory {
  people_search
  marketing
  data_aggregator
  background_check
  public_records
}

enum RemovalMethod {
  api
  form
  email
  manual
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  layer     String               @default("shield")
  priority  NotificationPriority @default(medium)
  category  NotificationCategory
  title     String
  body      String
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())
  linkTo    String?

  @@index([userId, isRead, createdAt(sort: Desc)])
}

enum NotificationPriority {
  critical
  high
  medium
  low
}

enum NotificationCategory {
  alias_health
  broker_removal
  security_alert
  system
}

enum BrokerScanStatus {
  not_found
  found
  removal_submitted
  removal_confirmed
  re_listed
}
